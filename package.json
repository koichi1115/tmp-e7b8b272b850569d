{
  "name": "kinjo-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "data:refresh": "node scripts/build-fixture.mjs",
    "data:verify": "node scripts/verify-fixture.mjs",
    "vehicle:verify": "node --experimental-strip-types --test tests/vehicles.test.ts",
    "free-range:verify": "node --experimental-strip-types --test tests/free-range.test.ts",
    "pan:verify": "node --experimental-strip-types --test tests/map-pan.test.ts",
    "via-lap:verify": "node --experimental-strip-types --test tests/via-lap.test.ts",
    "record:verify": "node --experimental-strip-types --test tests/prepared-record.test.ts",
    "boost:verify": "node --experimental-strip-types --test tests/boost-pads.test.ts",
    "boost:lap": "node --experimental-strip-types scripts/verify-boost-lap.mjs",
    "test": "npm run vehicle:verify && npm run free-range:verify && npm run boost:verify && npm run pan:verify && npm run via-lap:verify && npm run record:verify",
    "browser:verify": "node scripts/browser-verify-disabled.mjs",
    "build-mode:verify": "node scripts/verify-build-mode.mjs",
    "another-lap:verify": "node scripts/verify-another-lap.mjs",
    "public-play:verify": "node scripts/verify-public-play.mjs",
    "pages:build": "tsc && vite build",
    "pages:deploy": "node scripts/deploy-pages.mjs",
    "via:verify": "node --experimental-strip-types scripts/verify-via-course.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
